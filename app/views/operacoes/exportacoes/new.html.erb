<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<h1>Exportação de Manifestos e Retornos</h1>
<p><%= @pendentes_manifesto %> título(s) pendente(s) de manifesto.</p>
<p><%= @pendentes_retorno %> título(s) pendente(s) de retorno.</p>

<%= form_with url: operacoes_exportacao_path, method: :post do %>
  <label>Data <input type="date" name="data" value="<%= Date.current %>"></label>
  <button type="submit">Gerar</button>
<% end %>
