<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<h1>Distribuição de Títulos</h1>
<p><%= @pendentes %> título(s) pendente(s) de distribuição.</p>

<%= form_with url: operacoes_distribuicao_path, method: :post do %>
  <label>Data <input type="date" name="data" value="<%= Date.current %>"></label>
  <button type="submit">Processar</button>
<% end %>
