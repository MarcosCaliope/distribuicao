<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<h1>Entrar</h1>

<%= form_with url: sessao_path do |form| %>
  <%= form.label :login %><br>
  <%= form.text_field :login, required: true, autofocus: true, autocomplete: "username", value: params[:login] %><br>
  <%= form.label :password, "Senha" %><br>
  <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %><br>
  <%= form.submit "Entrar" %>
<% end %>
