<h1><%= dataset.titulo %></h1>
<p><%= dataset.subtitulo %></p>

<% if dataset.linhas.empty? %>
  <p>Nenhum registro encontrado.</p>
<% else %>
  <table border="1" cellpadding="4" cellspacing="0">
    <thead>
      <tr>
        <% dataset.colunas.each do |coluna| %>
          <th><%= coluna %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% dataset.linhas.each do |linha| %>
        <tr>
          <% linha.each do |valor| %>
            <td><%= valor %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
